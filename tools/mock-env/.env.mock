# Backend mock-mode env for the local mock verification stack.
# All 127.0.0.1 - matches production defaults, zero env gymnastics.
# Subscriptions are NOT simulated: lifecycle=off + env allowlist drive real
# sync_subscriptions from the backend (mock-mode branch in the allowlist
# service and realtime clients).
MIST_MOCK_MODE=true
NODE_ENV=development
PORT=8001
REALTIME_PRODUCTIZATION_MODE=shadow
REALTIME_SUBSCRIPTION_LIFECYCLE_MODE=off
REALTIME_STRATEGY_MODE=off
TDX_REALTIME_MODE=builtin
QMT_REALTIME_MODE=builtin
TDX_REALTIME_ALLOWLIST=600519.SH
QMT_REALTIME_ALLOWLIST=300502.SZ
MIST_REALTIME_REDIS_URL=redis://127.0.0.1:6379/0
# TDX_BASE_URL/QMT_BASE_URL unset -> defaults http://127.0.0.1:9001/9002

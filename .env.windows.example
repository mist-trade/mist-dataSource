# Windows API appliance datasource configuration
#
# Copy this file to .env on the Windows API machine and update absolute paths.
# Do not copy TDX SDK files into the appliance package; point this path at the
# existing authorized client installation on the machine. QMT uses the full-QMT
# built-in Python bridge and configured local DAT directory.

APP_ENV=production
LOG_LEVEL=INFO

# Python package index for uv sync. The appliance defaults to Tsinghua's mirror
# for faster dependency installation in China; change to https://pypi.org/simple
# if you want the official PyPI index.
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# Pin uv to the same Python minor version used to generate uv.lock.
UV_PYTHON=3.12

# TDX instance, consumed only by local MistBackend.
TDX_HOST=127.0.0.1
TDX_PORT=9001
TDX_REALTIME_MODE=legacy

# Required only while TDX_REALTIME_MODE=legacy. In builtin_experimental mode,
# the manually registered terminal script owns tqcenter instead.
# Expected layout:
#   F:/quant/tdx/PYPlugins/TPythClient.dll
#   F:/quant/tdx/PYPlugins/tpythclient.py        # if provided by your TDX install
#   F:/quant/tdx/PYPlugins/user/tqcenter.py
# TDX_SDK_PATH points to the user directory that contains tqcenter.py.
# TPythClient.dll stays one level above TDX_SDK_PATH.
TDX_SDK_PATH=F:/quant/tdx/PYPlugins/user

# Optional full-QMT bridge and local-DAT settings.
QMT_HOST=127.0.0.1
QMT_PORT=9002
QMT_BRIDGE_GATEWAY_URL=http://127.0.0.1:9002/qmt/bridge
QMT_REALTIME_MODE=off
MIST_QMT_SPIKE_OUTPUT_PATH=F:/quant/MistAPI/datasource/logs/qmt/mist_qmt_spike_output.json
QMT_LOCAL_DAT_ENABLED=false
QMT_LOCAL_DAT_DIR=D:/FullQMT/datadir
QMT_LOCAL_DAT_PERIODS=1d,1m,5m
QMT_LOCAL_DAT_BLOCK_AFTER=18:00
QMT_LOCAL_DAT_ON_BLOCK=retryable_error
QMT_LOCAL_DAT_STABILITY_WAIT_MS=500

# NestJS backend runs on the same Windows machine.
ALLOWED_ORIGINS=http://127.0.0.1:8001

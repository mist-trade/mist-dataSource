# 全局
APP_ENV=development          # development 用 TDX mock，production 用 TDX SDK + QMT bridge/local DAT
LOG_LEVEL=INFO

# TDX Instance
TDX_HOST=0.0.0.0
TDX_PORT=9001
# TDX SDK 路径 (Windows 生产环境必填)
# 指向包含 tqcenter.py 的目录 (通达信官方 SDK 结构如下):
#   D:/tdx/PYPlugins/
#       TPythClient.dll           ← SDK 会通过 Path(__file__).parents[1] 自动定位
#       user/
#           tqcenter.py           ← TDX_SDK_PATH 指向这个目录
# 例如: TDX_SDK_PATH=D:/tdx/PYPlugins/user
TDX_SDK_PATH=
TDX_REALTIME_MODE=legacy

# QMT Instance
QMT_HOST=0.0.0.0
QMT_PORT=9002
# Full-QMT bridge / local DAT historical bars.
# QMT_LOCAL_DAT_DIR points to the full QMT datadir, e.g. D:/国金QMT交易端模拟/datadir
QMT_BRIDGE_GATEWAY_URL=http://127.0.0.1:9002/qmt/bridge
QMT_REALTIME_MODE=off
MIST_QMT_SPIKE_OUTPUT_PATH=./logs/qmt/mist_qmt_spike_output.json
QMT_LOCAL_DAT_ENABLED=false
QMT_LOCAL_DAT_DIR=
QMT_LOCAL_DAT_PERIODS=1d,1m,5m
QMT_LOCAL_DAT_BLOCK_AFTER=18:00
QMT_LOCAL_DAT_ON_BLOCK=retryable_error
QMT_LOCAL_DAT_STABILITY_WAIT_MS=500

# NestJS 连接
ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8002

# 全局
APP_ENV=development
LOG_LEVEL=INFO

# TDX Instance
TDX_HOST=0.0.0.0
TDX_PORT=9001
# TDX history/reference uses :17709. Realtime always uses the builtin bridge.

# QMT Instance
QMT_HOST=0.0.0.0
QMT_PORT=9002
# Full-QMT built-in Python bridge. Historical bars are executed by
# ContextInfo.get_market_data_ex and do not require a local data path.
QMT_BRIDGE_GATEWAY_URL=http://127.0.0.1:9002/qmt/bridge
QMT_REALTIME_MODE=off
MIST_QMT_RUNTIME_PROBE_OUTPUT_PATH=./logs/qmt/mist_qmt_runtime_probe_output.json

# NestJS 连接
ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8002

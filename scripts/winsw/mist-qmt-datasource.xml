<service>
  <id>mist-qmt-datasource</id>
  <name>mist-qmt-datasource</name>
  <description>Mist QMT Python datasource native bars and HTTP polling bridge.</description>

  <workingdirectory>{{PROJECT_DIR}}</workingdirectory>
  <executable>{{DATASOURCE_EXECUTABLE}}</executable>
  <arguments>{{DATASOURCE_ARGUMENTS}}</arguments>

  <env name="APP_ENV" value="production" />
  <env name="QMT_HOST" value="{{QMT_HOST}}" />
  <env name="QMT_PORT" value="{{QMT_PORT}}" />
  <env name="QMT_BRIDGE_GATEWAY_URL" value="{{QMT_BRIDGE_GATEWAY_URL}}" />
  <env name="QMT_LOCAL_DAT_ENABLED" value="{{QMT_LOCAL_DAT_ENABLED}}" />
  <env name="QMT_LOCAL_DAT_DIR" value="{{QMT_LOCAL_DAT_DIR}}" />
  <env name="QMT_LOCAL_DAT_PERIODS" value="{{QMT_LOCAL_DAT_PERIODS}}" />
  <env name="QMT_LOCAL_DAT_BLOCK_AFTER" value="{{QMT_LOCAL_DAT_BLOCK_AFTER}}" />
  <env name="QMT_LOCAL_DAT_ON_BLOCK" value="{{QMT_LOCAL_DAT_ON_BLOCK}}" />
  <env name="QMT_LOCAL_DAT_STABILITY_WAIT_MS" value="{{QMT_LOCAL_DAT_STABILITY_WAIT_MS}}" />

  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>

  <logpath>{{LOG_DIR}}</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
